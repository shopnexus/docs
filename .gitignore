# Everything at the top of the repository is ignored unless listed here, so
# a stray file there is never committed by accident. A new top-level file or
# directory needs its own line.
/*
!/.dockerignore
!/.github/
!/.gitignore
!/CLAUDE.md
!/Dockerfile
!/LICENSE
!/README.md
!/manual/
!/nginx.conf
!/package.json
!/scripts/
!/superpowers/
!/typst/
!/web/

# Inside the directories above:
# Build artifacts của Typst (tái tạo từ .typ bằng `typst compile`)
*.pdf
typst/out/

# Bản nháp đã nghỉ hưu và tệp không dùng: giữ trên đĩa, không theo dõi.
typst/tmp/

