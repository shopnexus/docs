---
/* `/` picks the reader's language once: a saved choice, then navigator.language, else English. */
import { BASE, withBase } from "../lib/base";
import { SITE_TITLE } from "../lib/i18n";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <noscript><meta http-equiv="refresh" content={`0; url=${withBase("/en")}`} /></noscript>
    <script is:inline define:vars={{ base: BASE }}>
      (() => {
        let lang = "";
        try {
          lang = localStorage.getItem("docs-lang") || "";
        } catch {}
        if (lang !== "en" && lang !== "vi") {
          lang = (navigator.languages || [navigator.language]).some((l) => /^vi\b/i.test(l)) ? "vi" : "en";
        }
        location.replace(`${base}/${lang}${location.search}${location.hash}`);
      })();
    </script>
  </head>
  <body>
    <a href={withBase("/en")}>{SITE_TITLE}</a> · <a href={withBase("/vi")}>Tiếng Việt</a>
  </body>
</html>
