---
import { Icon } from "astro-icon/components";
import MobileDrawer from "../components/layout/mobile-drawer.astro";
import BaseLayout from "../layouts/base-layout.astro";
import { withBase } from "../lib/base";
import { LANGS } from "../lib/i18n";
import { TABS } from "../lib/tabs";

/* One static 404.html serves both languages; the script below shows the reader's language. */
const COPY = {
  en: {
    title: "This page took a different path",
    lead: "The link may be old or mistyped. Here’s where it probably went.",
    search: "Or search the docs…",
    browse: "Browse a section",
    home: "Go to docs home",
  },
  vi: {
    title: "Trang này đã chuyển sang lối khác",
    lead: "Có thể liên kết đã cũ hoặc gõ sai. Có lẽ trang bạn cần nằm ở đây.",
    search: "Hoặc tìm trong tài liệu…",
    browse: "Xem một phần",
    home: "Về trang chủ tài liệu",
  },
};
---

<BaseLayout title="Page not found" lang="en" altUrl="/vi">
  <main id="main" class="hero-glow min-h-[calc(100dvh-64px)]">
    {
      LANGS.map((lang) => (
        <div class="max-w-[640px] mx-auto px-4 pt-6 pb-16 flex flex-col items-center text-center" data-404={lang} hidden={lang !== "en"} lang={lang}>
          <div class="relative w-[220px] h-[220px] sm:w-[260px] sm:h-[260px]" aria-hidden="true">
            <div class="absolute left-1/2 bottom-8 -translate-x-1/2 w-[170px] h-5 rounded-[50%] bg-black/[.07] blur-md" />
            <img src={withBase("/img/docs-404.webp")} alt="" width="260" height="260" class="illus float relative w-full h-full object-contain" />
          </div>
          <div class="fade-up -mt-2 h-6 px-2.5 rounded-full bg-subtle border border-line text-[12px] font-semibold text-sub flex items-center tracking-wide font-mono">404</div>
          <h1 class="fade-up d1 mt-4 text-[28px] leading-[34px] sm:text-[36px] sm:leading-[44px] font-[650] tracking-[-0.025em]">{COPY[lang].title}</h1>
          <p class="fade-up d1 mt-3 text-[17px] leading-[28px] text-sub">{COPY[lang].lead}</p>
          <div class="fade-up d2 mt-3 h-7 max-w-full px-2.5 rounded-[8px] bg-subtle text-[12.5px] text-faint flex items-center gap-1.5 font-mono">
            <Icon name="ri:link-unlink" width="13" height="13" aria-hidden="true" />
            <span class="truncate" data-404-path />
          </div>
          <div class="fade-up d3 mt-7 w-full space-y-2" data-404-guesses />
          <button type="button" class="search-big fade-up d4 mt-6 w-full h-12 pl-4 pr-3 rounded-xl border border-line-sub bg-raised flex items-center gap-3 text-[15px] text-faint" data-search-open>
            <Icon name="ri:search-line" width="18" height="18" class="text-sub" aria-hidden="true" />
            <span class="flex-1 text-left">{COPY[lang].search}</span>
            <kbd class="kbd" data-mod-key>⌘K</kbd>
          </button>
          <div class="fade-up d5 mt-8 w-full pt-6 border-t border-line">
            <p class="text-[12px] font-medium text-faint">{COPY[lang].browse}</p>
            <div class="mt-3 flex flex-wrap justify-center gap-1">
              {TABS.map((tab) => (
                <a href={withBase(`/${lang}/${tab.id}`)} class="flex items-center gap-2 h-9 px-3 rounded-[10px] text-[14px] text-body hover:bg-subtle">
                  <img src={withBase(tab.img)} alt="" width="24" height="24" class="illus w-6 h-6 object-contain" loading="lazy" />
                  {tab.label[lang]}
                </a>
              ))}
            </div>
          </div>
          <a href={withBase(`/${lang}`)} class="mt-6 prose-link text-[13.5px] font-medium">{COPY[lang].home}</a>
        </div>
      ))
    }
    <template data-404-guess>
      <a class="lift group flex items-center gap-3 rounded-xl border border-line bg-page px-4 py-3 text-left">
        <span class="row-icon"><Icon name="ri:file-text-line" width="18" height="18" aria-hidden="true" /></span>
        <span class="flex-1 min-w-0">
          <span class="block text-[15px] font-medium leading-6 text-strong truncate" data-guess-title></span>
          <span class="block text-[12.5px] text-faint truncate" data-guess-crumb></span>
        </span>
        <Icon name="ri:arrow-right-line" width="16" height="16" class="arrow-nudge text-line-strong group-hover:text-strong" aria-hidden="true" />
      </a>
    </template>
  </main>
  <MobileDrawer lang="en" groups={[]} currentUrl="/404" altUrl="/vi" />
</BaseLayout>

<script>
  import { guessPages } from "../scripts/not-found";

  document.addEventListener("astro:page-load", () => void guessPages());
</script>
