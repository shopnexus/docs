---
import { Icon } from "astro-icon/components";
import { withBase } from "../../lib/base";
import type { DocPage } from "../../lib/content";
import { type Lang, TYPE_LABEL } from "../../lib/i18n";
import type { Tab } from "../../lib/tabs";
import { HOME_STRINGS } from "./home-strings";

interface Props {
  lang: Lang;
  paths: { url: string; img: string; title: string; body: string; cta: string }[];
  popular: { page: DocPage; icon: string; crumb: string }[];
  sections: { tab: Tab; links: DocPage[] }[];
}

const { lang, paths, popular, sections } = Astro.props;
const h = HOME_STRINGS[lang];
const cols = paths.length >= 4 ? "lg:grid-cols-4" : "lg:grid-cols-3";
// Four or more sections read better as a 2×n grid than as a 3-column grid with an orphan.
const sectionCols = sections.length % 3 === 0 ? "lg:grid-cols-3" : "lg:grid-cols-2";
---

<section class="pt-12">
  <h2 class="fade-up d2 text-[24px] leading-8 font-semibold tracking-[-0.015em]">{h.startTitle}</h2>
  <p class="fade-up d2 mt-1 text-[15px] leading-6 text-sub">{h.startLead}</p>
  <div class:list={["mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4", cols]}>
    {
      paths.map((p, i) => (
        <a href={withBase(p.url)} class={`group lift fade-up d${Math.min(i + 2, 5)} rounded-2xl border border-line bg-page p-5 flex flex-col`}>
          <img src={withBase(p.img)} alt="" width="92" height="92" class="illus icon-hop w-[92px] h-[92px] -ml-3.5 -mt-3.5 -mb-2 object-contain" loading="lazy" />
          <span class="mt-3 text-[16px] font-semibold leading-6 tracking-[-0.01em] text-strong">{p.title}</span>
          <span class="mt-1.5 text-[14px] leading-[22px] text-sub flex-1">{p.body}</span>
          <span class="mt-4 pt-3 border-t border-line text-[13.5px] font-medium text-brand-text flex items-center gap-1.5">
            {p.cta}
            <Icon name="ri:arrow-right-line" width="15" height="15" class="arrow-nudge" aria-hidden="true" />
          </span>
        </a>
      ))
    }
  </div>
</section>

{
  popular.length > 0 && (
    <section class="pt-14">
      <h2 class="text-[24px] leading-8 font-semibold tracking-[-0.015em]">{h.popularTitle}</h2>
      <p class="mt-1 text-[15px] leading-6 text-sub">{h.popularLead}</p>
      <div class="mt-4 rounded-2xl border border-line p-1.5 grid grid-cols-1 md:grid-cols-2 gap-x-1.5">
        {popular.map(({ page, icon, crumb }) => (
          <a href={withBase(page.url)} class="group flex items-center gap-4 px-3 sm:px-4 py-3.5 rounded-xl hover:bg-nav transition-colors">
            <span class="row-icon">
              <Icon name={icon} width="18" height="18" aria-hidden="true" />
            </span>
            <span class="flex-1 min-w-0">
              <span class="block text-[15px] font-medium leading-6 truncate text-strong">{page.entry.data.title}</span>
              <span class="block text-[12.5px] leading-5 text-faint truncate">{crumb}</span>
            </span>
            <span class:list={["chip hidden sm:inline-flex h-6! px-2! text-[12px]!", page.entry.data.type === "tutorial" && "chip-feature"]}>
              {TYPE_LABEL[page.entry.data.type]?.[lang]}
            </span>
            <span class="hidden sm:block w-14 text-right text-[12.5px] text-faint whitespace-nowrap">
              {page.entry.data.readingTime} {lang === "vi" ? "phút" : "min"}
            </span>
            <Icon name="ri:arrow-right-line" width="16" height="16" class="arrow-nudge text-line-strong group-hover:text-strong" aria-hidden="true" />
          </a>
        ))}
      </div>
    </section>
  )
}

<section class="pt-14">
  <h2 class="text-[24px] leading-8 font-semibold tracking-[-0.015em]">{h.browseTitle}</h2>
  <p class="mt-1 text-[15px] leading-6 text-sub">{h.browseLead(sections.length)}</p>
  <div class:list={["mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4", sectionCols]}>
    {
      sections.map(({ tab, links }) => (
        <div class="lift rounded-2xl border border-line bg-page p-5">
          <div class="flex items-start gap-3">
            <img src={withBase(tab.img)} alt="" width="56" height="56" class="illus w-14 h-14 -ml-2 -my-1 object-contain" loading="lazy" />
            <div>
              <a href={withBase(`/${lang}/${tab.id}`)} class="text-[16px] font-semibold leading-6 tracking-[-0.01em] hover:text-brand-text">
                {tab.label[lang]}
              </a>
              <p class="mt-0.5 text-[13px] leading-5 text-sub min-h-[40px]">{tab.blurb[lang]}</p>
            </div>
          </div>
          <div class="mt-3 pt-2 border-t border-line">
            {links.map((p) => (
              <a href={withBase(p.url)} class="flex items-center justify-between h-8 -mx-2 px-2 rounded-[8px] text-[14px] text-body hover:bg-subtle hover:text-strong">
                <span class="truncate">{p.entry.data.title}</span>
                <Icon name="ri:arrow-right-s-line" width="16" height="16" class="text-line-strong shrink-0" aria-hidden="true" />
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
