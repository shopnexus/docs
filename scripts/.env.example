# Biến môi trường cho capture-web-screenshots.mjs.
# KHÔNG điền giá trị thật vào tệp này — nó nằm trong git.
# Khi chạy thì truyền thẳng ở dòng lệnh, ví dụ:
#   SHOPNEXUS_BUYER_PASSWORD='...' node capture-web-screenshots.mjs

# Địa chỉ site đang chạy. Bỏ trống thì mặc định https://shopnexus.hopto.org
SHOPNEXUS_BASE_URL=

# Tài khoản người mua (email / SĐT / username đều được)
SHOPNEXUS_BUYER_EMAIL=
SHOPNEXUS_BUYER_PASSWORD=

# Tài khoản người bán
SHOPNEXUS_SELLER_EMAIL=
SHOPNEXUS_SELLER_PASSWORD=

# Tài khoản quản trị (dùng cho ảnh hàng đợi phiếu hỗ trợ).
# Đây là TÊN ĐĂNG NHẬP, không phải địa chỉ thư điện tử.
SHOPNEXUS_ADMIN_USERNAME=
SHOPNEXUS_ADMIN_PASSWORD=
